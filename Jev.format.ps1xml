<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>JevResponse</Name>
      <ViewSelectedBy><TypeName>JevResponse</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Decisions</Label></TableColumnHeader>
          <TableColumnHeader><Label>Model</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>Provider</Label><Width>14</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Summary</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Model</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Provider</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
